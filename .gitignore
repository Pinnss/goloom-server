# Compiled binaries — leading slash anchors pattern to repo root,
# so we don't accidentally hide cmd/goloom-wg-server/ etc.
/goloom-wg-server
/goloom-wg-server.exe
/goloom-wg-server-linux
/goloom-wg-client
/goloom-wg-client.exe

# Local benchmarking / profiling scratchpad — VPS-side scripts and
# captured traces that aren't part of the shipped product.
/bench-tools/

# Standalone Tailwind CLI binary, downloaded by `make tools-tailwind`.
# Stays per-developer because it's ~40MB and OS-specific.
/tools/tailwindcss
/tools/tailwindcss.exe

# Build outputs
/build/
/dist/

# Local configs (per-deployment)
/goloom-wg-server.yaml
/goloom-wg-client.yaml
admin.json

# Logs
*.log

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Secrets
*.key
*.pem
keystore.properties

# Session-meta — handoff notes, working logs, scratch summaries
# from claude-driven sessions. The /docs tree holds the operator-
# facing docs that ARE meant for the public repo; anything
# matching these patterns at root or in stray subdirs is internal
# scratchpad and stays local.
/HANDOFF*.md
/SESSION*.md
/NOTES*.md
/DISCUSSION*.md
/SUMMARY*.md
/SCRATCH*.md
*.session.md
*.handoff.md

# Local wintun.dll downloaded by dl_wintun.go — per-developer artifact.
/wintun.dll
/goloom-wg-client*.yaml

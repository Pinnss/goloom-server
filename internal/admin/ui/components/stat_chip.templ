package components

// StatChip is a small status pill — used both for inbound phase and for
// admin warning banners. The colour is derived from the phase string so
// callers don't have to keep a parallel switch.
templ StatChip(label, phase string) {
	<span class={ "chip", chipClasses(phase) }>{ label }</span>
}

// chipClasses maps inbound phase strings to Tailwind utility groups.
// Keep in sync with internal/inbound runner phase emissions.
func chipClasses(phase string) string {
	switch phase {
	case "relaying":
		return "bg-accent/20 text-accent border border-accent/40"
	case "handshaking", "waiting_peer", "starting":
		return "bg-warn/20 text-warn border border-warn/40"
	case "waiting_for_client":
		return "bg-blue-500/20 text-blue-300 border border-blue-500/40"
	case "error":
		return "bg-danger/20 text-danger border border-danger/40"
	case "stopped":
		return "bg-slate-700/40 text-slate-300 border border-slate-600/60"
	default:
		return "bg-slate-700/40 text-slate-300 border border-slate-600/60"
	}
}
